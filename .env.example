# Canonical origin — drives metadataBase, sitemap.xml and robots.txt, and is
# REQUIRED for magic-link sign-in: a guessed origin mails a live token to a
# domain this deployment may not own, so an unset one answers 501 instead.
# Set this to your own domain the day you buy one: every canonical, hreflang
# and sitemap URL follows it, and in production the old *.vercel.app host then
# 308s here (packages/core/src/routing.ts) so the two do not compete.
NEXT_PUBLIC_SITE_URL=https://vn-terminal.vercel.app

# Google Search Console, meta-tag verification method. Paste ONLY the content
# value, not the whole tag. Unset renders no tag at all, which is the correct
# state before you own the property — an empty one reads as a failed check.
GOOGLE_SITE_VERIFICATION=

# Reference USD/VND rate used ONLY for the domestic-vs-world gold premium.
# It is displayed alongside the result so readers can see the assumption.
NEXT_PUBLIC_USD_VND=26300

# Session signing key. REQUIRED in production — without it sessions are
# unavailable and every reader is anonymous (the site still serves).
# Generate with: openssl rand -hex 32
AUTH_SECRET=

# Identity provider: `magic` (emailed single-use link), `dev` (passwordless
# local sign-in, refuses to run in production) or `disabled`.
AUTH_PROVIDER=dev

# Persistence. With neither set, production has no database: auth and watchlist
# sync answer 501 and the site still serves. `file` is a local dev driver only —
# one process holds its own truth and Vercel's filesystem is read-only.
DATABASE_URL=
# Migrations take a session advisory lock, which a transaction pooler (Supabase
# :6543) will not hold. Point this at a direct/session connection (:5432); it
# falls back to DATABASE_URL when unset. See docs/database-setup.md.
MIGRATE_DATABASE_URL=
DB_DRIVER=

# Magic-link delivery. Left unset on purpose: `console` is already the default
# outside production, so local dev needs nothing here, and an unset value in
# production sends nothing and answers 501 rather than printing a redeemable
# link to the log — a link in the log is a session for whoever reads it.
# Setting `console` explicitly still opts in, including in production, so only
# write it here if you mean it. Production wants `resend` + RESEND_API_KEY.
MAIL_PROVIDER=
RESEND_API_KEY=
MAIL_FROM=

# Headline translation provider. `mock` (default) is glossary substitution.
TRANSLATE_PROVIDER=mock

# AI assistant provider. `mock` (default) composes answers from the page's real
# figures with NO model call and no key — safe to ship. Set `claude` + a key to
# use the real model; the endpoint is gated (Plus+ with a 2-ask free teaser) and
# rate-limited regardless. The free teaser needs AUTH_SECRET set to persist its
# signed counter.
ASK_PROVIDER=mock
ANTHROPIC_API_KEY=

# MoMo payments (tier upgrades). All three keys must be set or checkout answers
# 501 and the pricing page shows "coming soon" — the same fail-closed pattern as
# auth. Get them from the MoMo merchant dashboard; the sandbox has its own set.
# MOMO_ENDPOINT defaults to the sandbox create URL, so leave it unset until you
# have a live account. NEXT_PUBLIC_SITE_URL (above) must be your real origin —
# it is where MoMo sends the reader back and where the payment IPN is delivered.
# Prices live in src/lib/billing/plans.ts, not here.
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_ENDPOINT=

# Manual "MoMo QR" payment (no gateway account): an image URL of YOUR MoMo/bank
# receive QR. When set, a "MoMo QR" method appears — the reader scans and pays,
# you confirm the order by hand in /:locale/admin. The simplest way to take
# money before a merchant API is set up.
MANUAL_QR_URL=

# VNPay (optional, second card/QR gateway). Set both to enable; IPN URL is
# /api/billing/vnpay/ipn. VNPAY_PAY_URL defaults to the sandbox gateway.
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAY_URL=

# SePay bank-transfer auto-confirm (optional; cheapest for a solo operator — no
# merchant gateway, just a bank account SePay watches). Set all three to enable;
# webhook URL is /api/billing/sepay/webhook, authorised by SEPAY_API_KEY.
# SEPAY_BANK is the VietQR bank code (e.g. MB, VCB); SEPAY_ACCOUNT is the number.
SEPAY_API_KEY=
SEPAY_BANK=
SEPAY_ACCOUNT=

# Scheduled retention jobs (price-alert + daily-brief email), run by Vercel Cron.
# With no secret set the cron routes answer 501 (not open) — a delivery job must
# not be triggerable anonymously. Vercel sends this as a Bearer token on the
# scheduled request. Generate with: openssl rand -hex 32
CRON_SECRET=

# Owner allowlist for /:locale/admin (order reconciliation). Comma-separated
# emails; unset means the page 404s for everyone. Match the address you sign in
# with. Example: ADMIN_EMAILS=you@example.com
ADMIN_EMAILS=

# Product analytics (PostHog, SDK-free). Set the project key to turn on the
# funnel (pageview → signin_started → checkout_started → purchase_completed, plus
# ai_asked / watchlist_added). Unset = no-op, nothing sent. HOST defaults to the
# US cloud; use https://eu.i.posthog.com for the EU region.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# Salt for the person id server-side conversions are attributed to (a SHA-256 of
# the address, so no reader's email reaches PostHog). Server-only — NEVER prefix
# it NEXT_PUBLIC_, which would publish it in the bundle. Unset falls back to a
# literal in the source, which anyone holding a PostHog export can use to hash a
# known address and learn who subscribes. Generate with: openssl rand -hex 32
# Changing it RE-ANONYMISES everyone: every person id moves and the history
# behind the old ones does not follow, so set it once, before launch.
ANALYTICS_PERSON_SALT=

# SSI FastConnect Data (khối ngoại — foreign net buy/sell on the chart, gated to
# Plus). Register at SSI to get ConsumerID/Secret; unset = the foreign toggle is
# hidden (fail-closed). SSI_FCDATA_URL defaults to the production FCData base.
SSI_CONSUMER_ID=
SSI_CONSUMER_SECRET=
SSI_FCDATA_URL=
